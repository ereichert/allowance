# Copy this file to .env.containers and adjust values for your local environment.
# .env.containers is gitignored and never committed.
# If this file does not exist, docker-compose.yml defaults are used as-is.
# The justfile passes --env-file .env.containers to compose automatically when it exists.

# PostgreSQL credentials
POSTGRES_USER=allowance
POSTGRES_PASSWORD=allowance
POSTGRES_DB=allowance

# Full database URL (must match POSTGRES_* values above and use the postgres service hostname)
DATABASE_URL=postgres://allowance:allowance@postgres:5432/allowance

# Backend bind address inside the container (0.0.0.0 = all interfaces, required for port forwarding)
LISTEN_ADDR=0.0.0.0:3000

# Host port mappings (change if these conflict with other services running on your machine)
BACKEND_PORT=3000
FRONTEND_PORT=5173
POSTGRES_PORT=5432

# Log level for the backend (trace, debug, info, warn, error)
RUST_LOG=info

# Backend API base URL as seen by the browser.
# Uses localhost because the browser runs on the host and hits the forwarded port.
# VITE_ prefix is required for Vite to expose this variable to browser code.
VITE_ALLOWANCE_API_URL=http://localhost:3000
