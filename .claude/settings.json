{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "ToolSearch",
      "TodoWrite",
      "Skill(update-config *)",
      "Edit(/.claude/**)",
      "Write(/.claude/**)",
      "Read(/.claude/**)",
      "Skill(commit)",
      "Skill(commit:*)",
      "Skill(review-pr)",
      "Skill(review-pr:*)",
      "Skill(audit-comments)",
      "Skill(audit-comments:*)",
      "Bash(colima *)",
      "Bash(just *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)"
    ],
    "additionalDirectories": [
      "/Users/ereichert/dev/allowance/.claude",
      "/Users/ereichert/dev/allowance/.claude/skills"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-docker-compose-bypass.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "cd /Users/ereichert/dev/allowance && git diff --quiet -- backend/ frontend/ && git diff --cached --quiet -- backend/ frontend/ || just test"
          }
        ]
      }
    ]
  }
}
